{
    "name": "promptbrain-cli",
    "version": "0.1.0",
    "description": "Official CLI tool for interacting with the PromptBrain Context Engine",
    "author": "PromptBrain",
    "bin": {
        "pb": "./bin/pb"
    },
    "homepage": "https://github.com/promptbrain/cli",
    "license": "MIT",
    "main": "dist/index.js",
    "repository": "promptbrain/cli",
    "preferGlobal": true,
    "files": [
        "/bin",
        "/dist",
        "/npm-shrinkwrap.json",
        "/oclif.manifest.json"
    ],
    "dependencies": {
        "@oclif/core": "^4.8.0",
        "@oclif/plugin-help": "^6.2.36",
        "@oclif/plugin-plugins": "^5.4.54",
        "axios": "^1.6.0",
        "chalk": "^4.1.2",
        "fs-extra": "^11.1.1",
        "keytar": "^7.9.0",
        "open": "^9.1.0",
        "tslib": "^2.6.2",
        "uuid": "^13.0.0"
    },
    "devDependencies": {
        "@oclif/test": "^3.0.0",
        "@types/chai": "^4",
        "@types/fs-extra": "^11.0.4",
        "@types/keytar": "*",
        "@types/mocha": "^10.0.6",
        "@types/node": "^18",
        "@types/sinon": "^17.0.0",
        "@types/uuid": "^10.0.0",
        "chai": "^4",
        "fast-check": "^4.3.0",
        "mocha": "^10.8.2",
        "shx": "^0.3.3",
        "sinon": "^17.0.0",
        "ts-node": "^10.9.1",
        "typescript": "^5.2.2"
    },
    "oclif": {
        "bin": "pb",
        "dirname": "pb",
        "commands": "./dist/commands",
        "plugins": [
            "@oclif/plugin-help",
            "@oclif/plugin-plugins"
        ],
        "topicSeparator": " ",
        "topics": {
            "hello": {
                "description": "Say hello to the world and others"
            }
        }
    },
    "scripts": {
        "build": "shx rm -rf dist && tsc -b && shx mkdir -p dist/lib/templates && shx cp -r src/lib/templates/system dist/lib/templates/system",
        "lint": "eslint . --ext .ts --config .eslintrc",
        "postinstall": "node scripts/postinstall.js",
        "postpack": "shx rm -f oclif.manifest.json",
        "prepack": "npm run build && npx oclif manifest && oclif readme",
        "test": "mocha --require ts-node/register 'test/**/*.test.ts'",
        "version": "oclif readme && git add README.md",
        "release": "npm run build && npm version patch && git push --follow-tags",
        "release:minor": "npm run build && npm version minor && git push --follow-tags",
        "release:major": "npm run build && npm version major && git push --follow-tags"
    },
    "engines": {
        "node": ">=12.0.0"
    },
    "bugs": "https://github.com/promptbrain/cli/issues",
    "keywords": [
        "oclif",
        "cli",
        "promptbrain",
        "ai",
        "prompt-engineering",
        "context-engine",
        "developer-tools"
    ],
    "types": "dist/index.d.ts",
    "overrides": {
        "@oclif/plugin-plugins": {
            "npm": "^11.6.3"
        },
        "js-yaml": "^4.1.1"
    }
}
